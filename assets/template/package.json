{
  "name": "travel-ball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:map": "node scripts/prepare-map.mjs && npm run prepare:land",
    "prepare:land": "node scripts/prepare-land.mjs",
    "prepare:media": "node scripts/prepare-media.mjs",
    "check:data": "node scripts/check-data.mjs",
    "import:media": "node scripts/import-media.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-globe.gl": "2.38.0",
    "three": "^0.180.0",
    "three-conic-polygon-geometry": "2.1.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "mapshaper": "0.7.91",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
